global:
  smtp_smarthost: 'smtp.gmail.com:587'
  smtp_from: 'alertmanager@employee-management-portal.com'
  smtp_auth_username: 'SMTP_EMAIL_PLACEHOLDER'
  smtp_auth_password: 'SMTP_PASSWORD_PLACEHOLDER'
  smtp_require_tls: true

route:
  receiver: 'gmail-notifications'
  group_by: ['alertname']
  group_wait: 10s
  group_interval: 5m
  repeat_interval: 3h

receivers:
- name: 'gmail-notifications'
  email_configs:
  - to: 'RECIPIENT_EMAIL_PLACEHOLDER'
    send_resolved: true
    headers:
      subject: '⚠️ [Alertmanager] {{ .Status | toUpper }} - {{ .CommonLabels.alertname }}'
    html: |
      <h3>🚨 Container Alert: {{ .Status | toUpper }}</h3>
      <p>The following alerts were triggered:</p>
      <ul>
        {{ range .Alerts }}
          <li>
            <strong>Alert Name:</strong> {{ .Labels.alertname }}<br/>
            <strong>Severity:</strong> {{ .Labels.severity }}<br/>
            <strong>Summary:</strong> {{ .Annotations.summary }}<br/>
            <strong>Description:</strong> {{ .Annotations.description }}<br/>
            <strong>Started At:</strong> {{ .StartsAt }}<br/>
          </li>
        {{ end }}
      </ul>
